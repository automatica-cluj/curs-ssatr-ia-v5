          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="4, 6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7FB5;fontColor=#3A5A8C;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="qDan" target="dan">
